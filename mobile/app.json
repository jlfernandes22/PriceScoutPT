{
  "expo": {
    "name": "PriceScoutPT",
    "slug": "pricescoutpt",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "primaryColor": "#0050AA",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0050AA"
    },
    "android": {
      "package": "com.pricescoutpt.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0050AA"
      }
    },
    "ios": {
      "bundleIdentifier": "com.pricescoutpt.app",
      "icon": "./assets/icon.png",
      "supportsTablet": true
    },
    "extra": {
      "apiBaseUrl": "",
      "scrapeSecret": "",
      "note": "Valores reais de apiBaseUrl/scrapeSecret vivem em app.config.local.json (ignorado pelo git). Deixar vazio assume o fallback de desenvolvimento local."
    },
    "buildProperties": {
      "android": {
        "newArchEnabled": true
      },
      "ios": {
        "newArchEnabled": true
      }
    }
  }
}
